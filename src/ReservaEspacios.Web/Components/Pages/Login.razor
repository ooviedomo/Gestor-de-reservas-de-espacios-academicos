@page "/acceso/login"
@using Microsoft.AspNetCore.WebUtilities
@using ReservaEspacios.Domain.Common
@inject NavigationManager Navegador

<PageTitle>Acceder</PageTitle>

<h1>Acceder</h1>

@if (mensajeError is not null)
{
    <p data-testid="error">@mensajeError</p>
}

<form method="post" action="/acceso/autenticar">
    <div>
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="username" />
    </div>
    <div>
        <label for="contrasena">Contraseña</label>
        <input id="contrasena" name="contrasena" type="password" autocomplete="current-password" />
    </div>
    <button type="submit" id="acceder">Acceder</button>
</form>

<p>
    ¿No tienes cuenta? <a href="/acceso/registro">Regístrate como solicitante</a>.
</p>

@code {
    private static readonly string[] ErroresPermitidos =
    [
        DomainErrors.CredencialesInvalidas,
        DomainErrors.CuentaDesactivada
    ];

    private string? mensajeError;

    protected override void OnInitialized()
    {
        var uri = Navegador.ToAbsoluteUri(Navegador.Uri);
        var parametros = QueryHelpers.ParseQuery(uri.Query);

        if (parametros.TryGetValue("error", out var error) &&
            ErroresPermitidos.Contains(error.ToString()))
        {
            mensajeError = error.ToString();
        }
    }
}
